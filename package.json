{
  "name": "viper-coin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test:economics": "node scripts/test_economics.cjs && npm run test:feast && npm run test:claims",
    "test:monitor": "node scripts/test_monitor.cjs",
    "prebuild": "node scripts/sync_whitepaper.cjs",
    "test:whitepaper": "node scripts/test_whitepaper.mjs",
    "postbuild": "node scripts/finalize_site.cjs",
    "test:deployment": "node scripts/test_deployment.mjs",
    "whitepaper:source": "python3 scripts/generate_whitepaper.py",
    "test:feast": "node scripts/feast/test.mjs && node scripts/feast/properties.mjs && npm run test:pyth",
    "pretest:economics": "node scripts/sync_whitepaper.cjs",
    "test:claims": "node scripts/claims/test.mjs",
    "test:rehearsal": "node scripts/rehearse_localnet.mjs",
    "test:pyth": "node scripts/feast/test_pyth.mjs",
    "check:pyth": "node scripts/feast/check_pyth.mjs",
    "test:site": "node scripts/test_site.mjs",
    "test:brand": "node scripts/test_brand.mjs"
  },
  "dependencies": {
    "@mysten/dapp-kit-react": "^2.1.37",
    "@mysten/sui": "^2.33.2",
    "@noble/curves": "2.4.0",
    "ethers": "6.17.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.1.1",
    "bitcoinjs-message": "2.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.6.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
